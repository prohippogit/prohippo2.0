# Scratch output from npm run preview:computation — may contain client figures.
.tmp/

# Generated by `node scripts/print-voice-agent-config.mjs --kb` for uploading to
# Sarvam. A build artifact of functions/voiceKnowledge.js, like dist/ — committing
# it would create a second copy to keep in step.
prohippo-app-guide.md

# Generated by `node scripts/known-callers-csv.mjs` for Sarvam's known-callers
# list. Every row carries a signed token that grants read access to that
# account over the phone line — this is a credential file, not a build artifact.
known-callers*.csv

# Built by scripts/build-extension-zip.mjs on every dev/build run, from the
# extension/ folder that is committed. A build artefact, like dist/ — committing
# it would create a second copy of the extension to keep in step.
public/prohippo-sync-extension.zip

# Copied from src/ by scripts/build-functions-shared.mjs so the scheduled cause
# list can render the same PDF the browser renders. A build artefact of src/,
# like dist/ — committing it would create exactly the second copy the copy step
# exists to avoid. Rebuilt on every deploy (firebase.json predeploy).
functions/shared/

# Raw deck captures. The optimised, deck-sized copies under pitch/assets/ are
# committed; these 2880px originals are a build artefact of capture.mjs and are
# regenerated by re-running it.
pitch/screens/shots/

# Personal Claude Code overrides for this checkout (permission grants for
# connectors an individual has authorised). Project-wide settings would go in
# .claude/settings.json, which is committed.
.claude/settings.local.json
