rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin console access is a CUSTOM CLAIM minted by Cloud Functions
    // (scripts/grant-admin.mjs for the first one, adminSetRole after that).
    // Nothing a client can write can grant it.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Each signed-in user can read/write ONLY their own practice data,
    // stored under users/{their-uid}/... — at any nesting depth (e.g. the
    // per-assessee portalProceedings / portalNotices subcollections).
    //
    // Admins get NO access here, on purpose. This subtree holds the
    // practitioner's clients' PANs, notices and assessment records; the admin
    // console works off the `accounts` mirror below, which carries identity
    // and billing but never client data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---- Admin console -------------------------------------------------
    // Read-only from the browser, so the console can use live snapshots.
    // Every write goes through an audited callable running under the Admin
    // SDK, which bypasses these rules — so `allow write: if false` here costs
    // nothing and stops a compromised admin session doing unlogged damage.
    match /accounts/{accountId}     { allow read: if isAdmin(); allow write: if false; }
    match /referralCodes/{code}     { allow read: if isAdmin(); allow write: if false; }
    match /referralRedemptions/{id} { allow read: if isAdmin(); allow write: if false; }
    match /adminAudit/{entryId}     { allow read: if isAdmin(); allow write: if false; }
    match /growthDaily/{day}        { allow read: if isAdmin(); allow write: if false; }

    // Cost metering. `spend` holds token counts, latency and rupees — never a
    // prompt, a response, a phone number or an email address, because anything
    // in here is something support can read.
    match /spend/{callId}           { allow read: if isAdmin(); allow write: if false; }
    match /spendDaily/{day}         { allow read: if isAdmin(); allow write: if false; }
    match /usageDaily/{key}         { allow read: if isAdmin(); allow write: if false; }
    match /manualCosts/{month}      { allow read: if isAdmin(); allow write: if false; }

    // Plan catalogue — every signed-in user sees pricing; only functions edit it.
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else is denied by default. That includes otpChallenges,
    // deviceSessions, portalCreds, googleTokens, inboundAliases, referralVisits,
    // rateLimits and voiceRateLimits, which only Admin-SDK functions ever touch.
    //
    // WhatsApp adds three more, all deliberately unnamed here and so denied:
    //   waOptOut/{phone}    who has replied STOP. Keyed on the number alone
    //                       rather than on (practice, number), because everyone
    //                       is messaged from one WhatsApp number and a person
    //                       who opts out cannot tell the practices apart. A
    //                       browser able to read it could enumerate mobiles.
    //   waEvents/{msgId}    provider message id → the communications row it
    //                       belongs to, so the webhook is a document read
    //                       rather than a collection-group query. Same shape
    //                       and same reason as emailEvents.
    //   whatsappQuota/{uid} the per-user hourly send cap. Client-writable would
    //                       make it a cap the client can raise.
    // The practice's own copies — the group head, their consent, and every send
    // in users/{uid}/communications — live under the rule above, which is where
    // the practitioner reads them.
    //
    // inboundAliases maps an ITAT email address back to the practice that owns
    // it. It is top-level for the same reason googleTokens is: the webhook has
    // no signed-in user to scope the lookup by, and a client able to read the
    // collection could learn which addresses exist. The practice's own copy of
    // its address lives under users/{uid}/integrations/itatEmail, which the rule
    // above already covers.
    //
    // The voice agent needs no rule of its own: it reads users/{uid}/… under
    // the practitioner's own subtree above, and writes its call log to
    // users/{uid}/voiceCalls, which the same rule already covers. If this
    // feature ever appears to need a rule here, something has reached outside
    // users/{uid} and should be reconsidered instead.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
