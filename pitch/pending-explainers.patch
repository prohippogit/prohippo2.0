+/* ---------- slide explainer panel ----------
+   Seven slides carry a mascot panel of their own. Their bodies are already
+   full — measured, every one of them sits within about 25px of the footer —
+   so a picture placed in the body would push a sentence off the bottom of a
+   slide that clips rather than complains. The panel is taken out of flow and
+   parked in the band to the right of the heading, which every one of these
+   slides was leaving empty. The heading is capped to match, so a long title
+   wraps before it reaches the picture instead of running underneath it. */
+.slide.expl > .expl {
+  position: absolute; top: 46px; right: 60px; width: 216px; aspect-ratio: 16 / 9;
+  border-radius: 10px; overflow: hidden; background: var(--lav-2);
+  border: 1px solid var(--line); box-shadow: 0 6px 18px rgba(20,16,45,.08);
+}
+.slide.expl > .expl img { display: block; width: 100%; height: 100%; object-fit: cover; }
+/* 890px clears the panel's left edge at x=1004 with room to spare, and is just
+   wide enough for the longest of these seven titles (884px) to stay on one
+   line — a cap 10px tighter costs three of them a second line, and slide 4 has
+   nowhere to put one. */
+.slide.expl > .eyebrow, .slide.expl > h2 { max-width: 890px; }
+.slide.dark.expl > .expl { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.22); }
+
